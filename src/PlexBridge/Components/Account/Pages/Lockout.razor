@page "/Account/Lockout"

<PageTitle>Locked · PlexBridge</PageTitle>

<div class="acct-wrap">
    <MudText Typo="Typo.h4" GutterBottom="true">Account locked</MudText>
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        Too many sign-in attempts. Wait a few minutes and try again.
    </MudAlert>
    <MudLink Href="Account/Login" Class="mt-3 d-inline-block">Back to log in</MudLink>
</div>
