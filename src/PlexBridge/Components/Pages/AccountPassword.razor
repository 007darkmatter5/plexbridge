@page "/account/password"
@attribute [Authorize]
@using Microsoft.AspNetCore.Identity
@using PlexBridge.Data
@inject UserManager<ApplicationUser> Users
@inject SignInManager<ApplicationUser> SignIn
@inject AuthenticationStateProvider AuthState

<PageTitle>Password · PlexBridge</PageTitle>

<MudStack Spacing="3" Style="max-width: 32rem">
    <MudText Typo="Typo.h4">Password</MudText>
    <MudText Typo="Typo.body2">There is no email reset. If you lose this password, the recovery path is in the README.</MudText>
    @if (_message is not null)
    {
        <MudAlert Severity="_severity">@_message</MudAlert>
    }
    <MudTextField @bind-Value="_current" Label="Current password" InputType="InputType.Password" Variant="Variant.Outlined" />
    <MudTextField @bind-Value="_next" Label="New password" InputType="InputType.Password" Variant="Variant.Outlined"
                  HelperText="At least 8 characters, with an uppercase letter, a lowercase letter, a number, and a symbol." />
    <MudTextField @bind-Value="_confirm" Label="Confirm new password" InputType="InputType.Password" Variant="Variant.Outlined" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="Change">Change password</MudButton>
</MudStack>

@code {
    private string _current = "";
    private string _next = "";
    private string _confirm = "";
    private string? _message;
    private Severity _severity = Severity.Info;
    private bool _busy;

    private async Task Change()
    {
        _message = null;
        if (_next != _confirm)
        {
            _severity = Severity.Error;
            _message = "The new passwords don't match.";
            return;
        }

        _busy = true;
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            var user = await Users.GetUserAsync(state.User);
            if (user is null)
            {
                _severity = Severity.Error;
                _message = "Sign in again before changing the password.";
                return;
            }

            var result = await Users.ChangePasswordAsync(user, _current, _next);
            if (!result.Succeeded)
            {
                _severity = Severity.Error;
                _message = string.Join(" ", result.Errors.Select(error => error.Description));
                return;
            }

            await SignIn.RefreshSignInAsync(user);
            _current = _next = _confirm = "";
            _severity = Severity.Success;
            _message = "Password changed.";
        }
        finally
        {
            _busy = false;
        }
    }
}
