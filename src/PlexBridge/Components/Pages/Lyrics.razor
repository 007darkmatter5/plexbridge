@page "/lyrics"
@attribute [Authorize]
@implements IDisposable
@using PlexBridge.Lyrics
@inject LyricsPageService LyricsPage
@inject IDialogService Dialogs

<PageTitle>Lyrics · PlexBridge</PageTitle>

<MudStack Spacing="4">
    <div>
        <div class="pb-kicker">Music</div>
        <MudText Typo="Typo.h4" Class="mt-1">Lyrics</MudText>
        <MudText Typo="Typo.body1" Class="mt-2" Style="max-width: 46rem">
            Finds lyrics on LRCLIB for tracks in one music library. Synced lyrics are saved as a .lrc file next to the audio.
            Plain lyrics are saved as a .txt file. Nothing is written until you confirm, and a file that is already there is left alone.
        </MudText>
    </div>

    @if (_notice is not null)
    {
        <MudAlert Severity="@(_noticeError ? Severity.Error : Severity.Success)" Variant="Variant.Outlined">@_notice</MudAlert>
    }
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }

    @if (_editors.Count == 0 && !_loading)
    {
        <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined">Save a server on the dashboard before looking up lyrics.</MudAlert>
    }

    @foreach (var editor in _editors)
    {
        <MudPaper Class="pa-4" Outlined="true" @key="editor.ServerId">
            <MudStack Spacing="2">
                <div>
                    <MudText Typo="Typo.h6">Server @editor.Slot · @editor.Name</MudText>
                    <MudText Typo="Typo.body2" Class="pb-path">@editor.BaseUrl</MudText>
                </div>
                @if (!editor.HasToken)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">This server has no token yet.</MudAlert>
                }
                <MudText Typo="Typo.body2">
                    Choose the music library and the folder mounted in this container. PlexBridge reads that library's folders from Plex and maps them.
                    The usual container folder is /libraries. /music still works if that is the folder you mounted.
                    The same paths are on Library paths, for movies and TV as well.
                </MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" Value="editor.SectionKey" ValueChanged="@(key => OnMappedLibrary(editor, key))" ToStringFunc="@(key => LibraryLabel(editor, key))" Label="Music library" Variant="Variant.Outlined" Disabled="_saving || !editor.HasToken" AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem T="string" Value="@("")">Choose a library</MudSelectItem>
                            @if (!string.IsNullOrEmpty(editor.SectionKey) && editor.Libraries.All(item => item.Key != editor.SectionKey))
                            {
                                <MudSelectItem T="string" Value="@editor.SectionKey">@LibraryLabel(editor, editor.SectionKey)</MudSelectItem>
                            }
                            @foreach (var library in editor.Libraries)
                            {
                                <MudSelectItem T="string" Value="@library.Key">@library.Title</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Value="editor.ContainerFolder" ValueChanged="@(value => OnContainer(editor, value))" Label="Container folder" Variant="Variant.Outlined" Disabled="_saving" HelperText="Usually /libraries" Immediate="true" />
                    </MudItem>
                </MudGrid>
                @if (!string.IsNullOrEmpty(editor.LibraryNote))
                {
                    <MudText Typo="Typo.caption">@editor.LibraryNote</MudText>
                }
                @if (editor.UseManualMaps)
                {
                    <MudText Typo="Typo.caption">Manual prefixes are in use.</MudText>
                    @foreach (var map in FilledMaps(editor))
                    {
                        <MudText Typo="Typo.body2" Class="pb-path">@ManualLine(map, ManualMatch(editor, map))</MudText>
                    }
                }
                else if (editor.Matches.Count > 0)
                {
                    <MudText Typo="Typo.caption">Library mapping is in use.</MudText>
                    @foreach (var match in editor.Matches)
                    {
                        <MudText Typo="Typo.body2" Class="pb-path">@MatchLine(match)</MudText>
                    }
                    @if (editor.Matches.All(match => match.Status != LyricsMapStatus.Ok) && FilledMaps(editor).Count > 0)
                    {
                        <MudText Typo="Typo.caption">A folder marked Not found is not used. Turn on manual prefixes to use a saved prefix instead.</MudText>
                    }
                }
                else if (FilledMaps(editor).Count > 0)
                {
                    <MudText Typo="Typo.caption">Saved path prefixes</MudText>
                    @foreach (var map in FilledMaps(editor))
                    {
                        <MudText Typo="Typo.body2" Class="pb-path">@map.PlexPrefix → @map.ContainerPrefix</MudText>
                    }
                }
                <MudTooltip Text="@CheckReason(editor)">
                    <span class="d-inline-block">
                        <MudButton Variant="Variant.Outlined" Disabled="@(!CanCheck(editor))" OnClick="() => Check(editor)">Check paths</MudButton>
                    </span>
                </MudTooltip>
                <MudText Typo="Typo.caption">@CheckReason(editor)</MudText>
                <MudExpansionPanels>
                    <MudExpansionPanel Text="Advanced" Expanded="false">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.body2">Manual prefixes. Turn this on when this container has a synced copy and cannot see the folder Plex uses. Writes use these prefixes while the switch is on.</MudText>
                            <MudSwitch T="bool" Value="editor.UseManualMaps" ValueChanged="@(value => OnManual(editor, value))" Label="Use manual prefixes" Color="Color.Primary" Disabled="_saving" />
                            @foreach (var map in editor.Maps)
                            {
                                <MudGrid Spacing="2" @key="map">
                                    <MudItem xs="12" md="5">
                                        <MudTextField T="string" @bind-Value="map.PlexPrefix" Label="Plex path prefix" Variant="Variant.Outlined" Disabled="_saving" />
                                    </MudItem>
                                    <MudItem xs="12" md="5">
                                        <MudTextField T="string" @bind-Value="map.ContainerPrefix" Label="Container path" Variant="Variant.Outlined" Disabled="_saving" />
                                    </MudItem>
                                    <MudItem xs="12" md="2" Class="d-flex align-center">
                                        <MudButton Variant="Variant.Text" Color="Color.Default" Disabled="_saving" OnClick="() => editor.Maps.Remove(map)">Remove</MudButton>
                                    </MudItem>
                                </MudGrid>
                            }
                            <MudButton Variant="Variant.Outlined" Disabled="_saving" OnClick="() => editor.Maps.Add(new LyricsMapInput())">Add path</MudButton>
                        </MudStack>
                    </MudExpansionPanel>
                </MudExpansionPanels>
                <MudSwitch T="bool" @bind-Value="editor.AutoCheck" Label="Check newly added tracks" Color="Color.Primary" Disabled="_saving" />
                <MudText Typo="Typo.caption">
                    Off by default. When you turn it on, PlexBridge looks up tracks added after that moment.
                    It does not go back through the library, and it does not replace lyrics that are already there.
                </MudText>
                <MudNumericField T="int" @bind-Value="editor.IntervalHours" Label="Hours between checks" Variant="Variant.Outlined" Min="1" Max="168" Disabled="_saving || !editor.AutoCheck" Style="max-width: 16rem" />
                <MudNumericField T="int" @bind-Value="editor.SyncIntervalMinutes" Label="Minutes between Plex refreshes" Variant="Variant.Outlined" Min="1" Max="60" Disabled="_saving" Style="max-width: 16rem" />
                <MudNumericField T="int" @bind-Value="editor.SyncWindowMinutes" Label="Minutes to keep trying" Variant="Variant.Outlined" Min="2" Max="240" Disabled="_saving" Style="max-width: 16rem" />
                <MudText Typo="Typo.caption">
                    After a lyrics file is written, Plex is refreshed on that interval until it reports a lyrics stream, or the time runs out.
                    This waits for a copy to sync to the server Plex can see.
                </MudText>
                @if (editor.LastAutoCheckUtc is DateTimeOffset last)
                {
                    <MudText Typo="Typo.caption">Last check @last.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudText>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving" OnClick="() => Save(editor)">Save</MudButton>
            </MudStack>
        </MudPaper>
    }

    @if (_syncItems.Count > 0)
    {
        <MudPaper Class="pa-4" Outlined="true">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h6">Waiting for Plex</MudText>
                <MudText Typo="Typo.body2">Lyrics files that are written, and Plex has not reported a lyrics stream yet.</MudText>
                @foreach (var item in _syncItems)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" @key="item.Id">
                        <div>
                            <MudText Typo="Typo.body2">@SyncTitle(item)</MudText>
                            <MudText Typo="Typo.caption">@item.Status</MudText>
                        </div>
                        @if (item.Status == LyricsSyncStatus.Missed)
                        {
                            <MudButton Variant="Variant.Outlined" Disabled="_busy" OnClick="() => RefreshSync(item)">Refresh in Plex</MudButton>
                        }
                    </MudStack>
                }
            </MudStack>
        </MudPaper>
    }

    <MudPaper Class="pa-4" Outlined="true">
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6">Find lyrics</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" md="4">
                    <MudSelect T="int" Value="_serverId" ValueChanged="OnServer" Label="Server" Variant="Variant.Outlined" Disabled="_busy" AnchorOrigin="Origin.BottomCenter">
                        @foreach (var editor in _editors.Where(item => item.HasToken))
                        {
                            <MudSelectItem T="int" Value="@editor.ServerId">Server @editor.Slot · @editor.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="string" Value="_sectionKey" ValueChanged="OnLibrary" ToStringFunc="@ScanLibraryLabel" Label="Music library" Variant="Variant.Outlined" Disabled="_busy || _libraries.Count == 0" AnchorOrigin="Origin.BottomCenter">
                        @foreach (var library in _libraries)
                        {
                            <MudSelectItem T="string" Value="@library.Key">@library.Title</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="string" Value="_artistKey" ValueChanged="OnArtist" Label="Artist" Variant="Variant.Outlined" Disabled="_busy || _artists.Count == 0" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem T="string" Value="@("")">All artists</MudSelectItem>
                        @foreach (var artist in _artists)
                        {
                            <MudSelectItem T="string" Value="@artist.RatingKey">@artist.Title</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="_albumKey" Label="Album" Variant="Variant.Outlined" Disabled="_busy || _albums.Count == 0" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem T="string" Value="@("")">All albums</MudSelectItem>
                        @foreach (var album in _albums)
                        {
                            <MudSelectItem T="string" Value="@album.RatingKey">@AlbumLabel(album)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
            @if (_catalogNote is not null)
            {
                <MudText Typo="Typo.caption">@_catalogNote</MudText>
            }
            <MudStack Row="true" Spacing="1">
                    <MudTooltip Text="@ScanReason()">
                        <span class="d-inline-block">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy || _serverId == 0 || string.IsNullOrEmpty(_sectionKey)" OnClick="Scan">Scan</MudButton>
                        </span>
                    </MudTooltip>
                @if (_job?.State == LyricsJobState.Running)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="Cancel">Cancel</MudButton>
                }
            </MudStack>
            @if (_job is not null)
            {
                <MudText Typo="Typo.body2">@_job.Status</MudText>
                @if (_job.State == LyricsJobState.Running && _job.Total > 0)
                {
                    <MudProgressLinear Value="@Percent(_job.Done, _job.Total)" />
                }
                else if (_job.State == LyricsJobState.Running)
                {
                    <MudProgressLinear Indeterminate="true" />
                }
            }
        </MudStack>
    </MudPaper>

    @if (_tracks.Count > 0)
    {
        <MudPaper Class="pa-4" Outlined="true">
            <MudStack Spacing="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                    <MudText Typo="Typo.h6">@_job?.LibraryName</MudText>
                    <MudText Typo="Typo.body2">@Summary()</MudText>
                </MudStack>
                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                    <MudButton Variant="@FilterVariant("all")" Color="Color.Primary" OnClick='() => SetFilter("all")'>All</MudButton>
                    <MudButton Variant="@FilterVariant("ready")" Color="Color.Primary" OnClick='() => SetFilter("ready")'>Ready to write</MudButton>
                    <MudButton Variant="@FilterVariant("have")" Color="Color.Primary" OnClick='() => SetFilter("have")'>Already has lyrics</MudButton>
                    <MudButton Variant="@FilterVariant("problem")" Color="Color.Primary" OnClick='() => SetFilter("problem")'>Path and misses</MudButton>
                </MudStack>
                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Outlined" Disabled="_busy" OnClick="() => SelectVisible(true)">Select ready</MudButton>
                    <MudButton Variant="Variant.Outlined" Disabled="_busy" OnClick="() => SelectVisible(false)">Clear</MudButton>
                    <MudTooltip Text="@WriteReason()">
                        <span class="d-inline-block">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy || SelectedCount() == 0" OnClick="WriteSelected">Write selected</MudButton>
                        </span>
                    </MudTooltip>
                    <MudText Typo="Typo.caption">@WriteReason()</MudText>
                </MudStack>
                @if (_pageCount > 1)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudButton Variant="Variant.Text" Disabled="_page <= 1" OnClick="() => _page--">Previous</MudButton>
                        <MudText Typo="Typo.body2">Page @_page of @_pageCount</MudText>
                        <MudButton Variant="Variant.Text" Disabled="_page >= _pageCount" OnClick="() => _page++">Next</MudButton>
                    </MudStack>
                }
                @foreach (var group in PageGroups())
                {
                    <div @key="group.Key">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="mt-2">
                            <MudText Typo="Typo.subtitle1">@group.First().Artist — @group.First().Album</MudText>
                            @if (!string.IsNullOrEmpty(group.First().AlbumKey) && _job?.State != LyricsJobState.Running)
                            {
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="_busy" OnClick="() => RefreshAlbum(group.First().AlbumKey)">Refresh album</MudButton>
                            }
                        </MudStack>
                        <MudSimpleTable Dense="true" Hover="true" Style="overflow-x: auto">
                            <thead>
                                <tr>
                                    <th style="width: 3rem"></th>
                                    <th>Track</th>
                                    <th>Status</th>
                                    <th>Detail</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var track in group)
                                {
                                    <tr @key="track.RatingKey">
                                        <td>
                                            <MudCheckBox T="bool" Value="track.Selected" ValueChanged="@(value => Toggle(track, value))" Disabled="@(!track.CanSelect || _busy)" Dense="true" />
                                        </td>
                                        <td>
                                            <div>@track.Title</div>
                                            @if (!string.IsNullOrEmpty(track.FileName))
                                            {
                                                <div class="pb-path">@track.FileName</div>
                                            }
                                        </td>
                                        <td>@track.Status</td>
                                        <td>
                                            <div>@track.Detail</div>
                                            @if (!string.IsNullOrWhiteSpace(track.ApplyResult))
                                            {
                                                <div>@track.ApplyResult</div>
                                            }
                                            @if (track.Status is LyricsStatus.NotReachable or LyricsStatus.NotWritable && !string.IsNullOrWhiteSpace(track.PlexPath))
                                            {
                                                <div class="pb-path">@track.PlexPath</div>
                                            }
                                            @if (track.Status == LyricsSyncStatus.Missed)
                                            {
                                                <MudButton Variant="Variant.Text" Disabled="_busy" OnClick="() => RefreshSyncTrack(track)">Refresh in Plex</MudButton>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </div>
                }
            </MudStack>
        </MudPaper>
    }
</MudStack>

@code {
    private readonly List<LyricsServerEditor> _editors = [];
    private readonly List<PlexSectionInfo> _libraries = [];
    private readonly List<PlexCatalogItem> _artists = [];
    private readonly List<PlexCatalogItem> _albums = [];
    private List<LyricsTrackRow> _tracks = [];
    private List<LyricsSyncRow> _syncItems = [];
    private readonly HashSet<string> _seenSync = new(StringComparer.Ordinal);
    private bool _loading = true;
    private bool _saving;
    private bool _busy;
    private string? _error;
    private string? _notice;
    private bool _noticeError;
    private string? _catalogNote;
    private int _serverId;
    private string _sectionKey = "";
    private string _artistKey = "";
    private string _albumKey = "";
    private string _filter = "all";
    private int _page = 1;
    private LyricsJobSnapshot? _job;
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _poll;
    private PeriodicTimer? _syncTimer;
    private CancellationTokenSource? _syncPoll;

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        _loading = _editors.Count == 0;
        _error = null;
        try
        {
            var forms = await LyricsPage.LoadAsync();
            _editors.Clear();
            _editors.AddRange(forms.Select(form => new LyricsServerEditor
            {
                ServerId = form.ServerId,
                Slot = form.Slot,
                Name = form.Name,
                BaseUrl = form.BaseUrl,
                HasToken = form.HasToken,
                AutoCheck = form.AutoCheck,
                IntervalHours = form.IntervalHours,
                LastAutoCheckUtc = form.LastAutoCheckUtc,
                SectionKey = form.SectionKey ?? "",
                SectionTitle = form.SectionTitle ?? "",
                ContainerFolder = LibraryPathMapper.ResolveContainer(form.ContainerFolder),
                UseManualMaps = form.UseManualMaps,
                SyncIntervalMinutes = form.SyncIntervalMinutes,
                SyncWindowMinutes = form.SyncWindowMinutes,
                Maps = form.Maps.Select(map => new LyricsMapInput { PlexPrefix = map.PlexPrefix, ContainerPrefix = map.ContainerPrefix }).ToList(),
                Matches = form.Matches.ToList()
            }));
            foreach (var editor in _editors.Where(item => item.HasToken))
            {
                try
                {
                    editor.Libraries.AddRange(await LyricsPage.MusicLibrariesAsync(editor.ServerId));
                    var named = editor.Libraries.FirstOrDefault(item => item.Key == editor.SectionKey);
                    if (named is not null && !string.IsNullOrWhiteSpace(named.Title))
                        editor.SectionTitle = named.Title;
                }
                catch (Exception exception) when (exception is PlexBridgeException or PlexRequestException)
                {
                    editor.LibraryNote = exception.Message;
                }
            }
            if (_serverId == 0)
                _serverId = _editors.FirstOrDefault(item => item.HasToken)?.ServerId ?? 0;
            if (_libraries.Count == 0 && _serverId != 0)
                await OnServer(_serverId);
            await LoadSync();
        }
        catch (Exception)
        {
            _error = "The lyrics settings could not be loaded.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Save(LyricsServerEditor editor)
    {
        _saving = true;
        _notice = null;
        _error = null;
        try
        {
            if (!editor.UseManualMaps && !string.IsNullOrEmpty(editor.SectionKey))
            {
                var hadMaps = FilledMaps(editor).Count > 0;
                var report = await LyricsPage.SaveLibraryAsync(Input(editor));
                _noticeError = false;
                if (report.Maps.Count == 0 && hadMaps)
                    _notice = "No files from that library were found under the container folder. Existing path prefixes were kept.";
                else if (report.Maps.Count == 0)
                    _notice = "No files from that library were found under the container folder.";
                else
                    _notice = "Saved lyrics settings for " + editor.Name + ".";
            }
            else
            {
                await LyricsPage.SaveAsync(Input(editor));
                _noticeError = false;
                _notice = "Saved lyrics settings for " + editor.Name + ".";
            }
            await Load();
        }
        catch (PlexBridgeException exception)
        {
            _noticeError = true;
            _notice = exception.Message;
        }
        catch (Exception)
        {
            _noticeError = true;
            _notice = "The lyrics settings could not be saved.";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task Check(LyricsServerEditor editor)
    {
        _saving = true;
        _notice = null;
        _error = null;
        try
        {
            var report = editor.UseManualMaps
                ? await LyricsPage.CheckManualAsync(editor.ServerId, editor.SectionKey, editor.Maps)
                : await LyricsPage.MapLibraryAsync(editor.ServerId, editor.SectionKey, editor.ContainerFolder);
            editor.Matches = report.Matches.ToList();
            editor.SectionTitle = report.SectionTitle;
            _noticeError = false;
            _notice = "Checked " + report.SectionTitle + ".";
        }
        catch (Exception exception) when (exception is PlexBridgeException or PlexRequestException)
        {
            _noticeError = true;
            _notice = exception.Message;
        }
        catch (Exception)
        {
            _noticeError = true;
            _notice = "The library folders could not be checked.";
        }
        finally
        {
            _saving = false;
        }
    }

    private static void OnMappedLibrary(LyricsServerEditor editor, string sectionKey)
    {
        if (editor.SectionKey == sectionKey)
            return;
        editor.SectionKey = sectionKey;
        editor.SectionTitle = editor.Libraries.FirstOrDefault(item => item.Key == sectionKey)?.Title ?? "";
        editor.Matches.Clear();
    }

    private static void OnManual(LyricsServerEditor editor, bool value)
    {
        if (editor.UseManualMaps == value)
            return;
        editor.UseManualMaps = value;
        editor.Matches.Clear();
    }

    private static void OnContainer(LyricsServerEditor editor, string value)
    {
        if (editor.ContainerFolder == value)
            return;
        editor.ContainerFolder = value ?? "";
        editor.Matches.Clear();
    }

    private static LyricsSettingsInput Input(LyricsServerEditor editor)
        => new()
        {
            ServerId = editor.ServerId,
            AutoCheck = editor.AutoCheck,
            IntervalHours = editor.IntervalHours,
            SectionKey = editor.SectionKey,
            SectionTitle = string.IsNullOrEmpty(editor.SectionKey) ? null : LibraryLabel(editor, editor.SectionKey),
            ContainerFolder = editor.ContainerFolder,
            UseManualMaps = editor.UseManualMaps,
            SyncIntervalMinutes = editor.SyncIntervalMinutes,
            SyncWindowMinutes = editor.SyncWindowMinutes,
            Maps = editor.Maps,
            Matches = editor.UseManualMaps
                ? editor.Matches.Where(match => match.Status != LyricsMapStatus.NotFound).ToList()
                : string.IsNullOrEmpty(editor.SectionKey) ? [] : editor.Matches
        };

    private static List<LyricsMapInput> FilledMaps(LyricsServerEditor editor)
        => editor.Maps.Where(map => !string.IsNullOrWhiteSpace(map.PlexPrefix) || !string.IsNullOrWhiteSpace(map.ContainerPrefix)).ToList();

    private static string LibraryLabel(LyricsServerEditor editor, string? key)
        => LibraryNames.Label(key, editor.SectionTitle, editor.Libraries.Select(library => (library.Key, library.Title)));

    private string ScanLibraryLabel(string? key)
        => LibraryNames.Label(key, null, _libraries.Select(library => (library.Key, library.Title)));

    private bool CanCheck(LyricsServerEditor editor)
        => !_saving && editor.HasToken && !string.IsNullOrEmpty(editor.SectionKey);

    private string CheckReason(LyricsServerEditor editor)
    {
        if (!editor.HasToken)
            return "This server has no token yet.";
        if (string.IsNullOrEmpty(editor.SectionKey))
            return "Choose a music library first.";
        if (_saving)
            return "Wait until the current save finishes.";
        if (editor.UseManualMaps)
            return "Check paths confirms the container folder exists, is writable, and that a few Plex tracks are there. It does not need to see the Plex folder itself, and it does not write lyrics.";
        return "Check paths only reads the mount and a few files. It does not write lyrics. The Read-only badge does not block it.";
    }

    private string ScanReason()
    {
        if (_busy)
            return "Wait until the current run finishes.";
        if (_serverId == 0)
            return "Save a server before scanning.";
        if (string.IsNullOrEmpty(_sectionKey))
            return "Choose a music library first.";
        return "Scan looks up lyrics. It does not write files.";
    }

    private string WriteReason()
    {
        if (_busy)
            return "Wait until the current run finishes.";
        if (SelectedCount() == 0)
            return "Select lyrics that are ready to write. Writing files is the only change, and it waits until you confirm.";
        return "This writes the selected lyrics files. Nothing is written until you confirm.";
    }

    private static string MatchLine(LyricsLocationMatch match)
        => PathMapText.Line(match.PlexLocation, match.ContainerPrefix, match.Status);

    private static LyricsLocationMatch? ManualMatch(LyricsServerEditor editor, LyricsMapInput map)
        => editor.Matches.FirstOrDefault(match =>
            match.Status != LyricsMapStatus.NotFound
            && SamePrefix(match.PlexLocation, map.PlexPrefix));

    private static string ManualLine(LyricsMapInput map, LyricsLocationMatch? match)
        => match is null
            ? map.PlexPrefix + " → " + map.ContainerPrefix
            : PathMapText.Line(match.PlexLocation, match.ContainerPrefix ?? map.ContainerPrefix, match.Status);

    private static bool SamePrefix(string left, string right)
    {
        var windows = left.Contains('\\') || right.Contains('\\') || left.Contains(':') || right.Contains(':');
        var comparison = windows ? StringComparison.OrdinalIgnoreCase : StringComparison.Ordinal;
        return string.Equals(left.Replace('\\', '/').TrimEnd('/'), right.Replace('\\', '/').TrimEnd('/'), comparison);
    }

    private async Task OnServer(int serverId)
    {
        _serverId = serverId;
        _libraries.Clear();
        _artists.Clear();
        _albums.Clear();
        _sectionKey = "";
        _artistKey = "";
        _albumKey = "";
        _catalogNote = null;
        if (serverId == 0)
            return;
        _busy = true;
        try
        {
            var libraries = await LyricsPage.MusicLibrariesAsync(serverId);
            _libraries.AddRange(libraries);
            _catalogNote = libraries.Count == 0 ? "This server has no music library." : null;
        }
        catch (PlexBridgeException exception)
        {
            _catalogNote = exception.Message;
        }
        catch (PlexRequestException exception)
        {
            _catalogNote = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnLibrary(string sectionKey)
    {
        _sectionKey = sectionKey;
        _artists.Clear();
        _albums.Clear();
        _artistKey = "";
        _albumKey = "";
        if (string.IsNullOrEmpty(sectionKey))
            return;
        _catalogNote = "Reading artists";
        try
        {
            var artists = await LyricsPage.ArtistsAsync(_serverId, sectionKey);
            _artists.AddRange(artists.OrderBy(item => item.Title, StringComparer.OrdinalIgnoreCase));
            _catalogNote = null;
        }
        catch (Exception exception) when (exception is PlexBridgeException or PlexRequestException)
        {
            _catalogNote = exception.Message;
        }
    }

    private async Task OnArtist(string artistKey)
    {
        _artistKey = artistKey;
        _albums.Clear();
        _albumKey = "";
        if (string.IsNullOrEmpty(artistKey) || string.IsNullOrEmpty(_sectionKey))
            return;
        _catalogNote = "Reading albums";
        try
        {
            var albums = await LyricsPage.AlbumsAsync(_serverId, _sectionKey, artistKey);
            _albums.AddRange(albums.OrderBy(item => item.Title, StringComparer.OrdinalIgnoreCase));
            _catalogNote = null;
        }
        catch (Exception exception) when (exception is PlexBridgeException or PlexRequestException)
        {
            _catalogNote = exception.Message;
        }
    }

    private async Task Scan()
    {
        _notice = null;
        _error = null;
        var library = _libraries.FirstOrDefault(item => item.Key == _sectionKey);
        _job = await LyricsPage.StartScanAsync(_serverId, _sectionKey, Blank(_artistKey), Blank(_albumKey), library?.Title ?? "Music");
        _tracks = _job.Tracks.ToList();
        _busy = _job.State == LyricsJobState.Running;
        _page = 1;
        StartPolling();
    }

    private async Task Cancel()
    {
        if (_job is null)
            return;
        await LyricsPage.CancelAsync(_job.Id);
    }

    private async Task Toggle(LyricsTrackRow track, bool selected)
    {
        track.Selected = selected;
        if (_job is not null)
            await LyricsPage.SelectAsync(_job.Id, [track.RatingKey], selected);
    }

    private async Task SelectVisible(bool selected)
    {
        if (_job is null)
            return;
        var keys = Filtered().Where(row => row.CanSelect).Select(row => row.RatingKey).ToList();
        await LyricsPage.SelectAsync(_job.Id, keys, selected);
        foreach (var row in _tracks.Where(row => keys.Contains(row.RatingKey)))
            row.Selected = selected;
    }

    private async Task WriteSelected()
    {
        if (_job is null || SelectedCount() == 0)
            return;
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Write lyrics",
            "This writes " + SelectedCount() + " lyrics files next to the audio, then refreshes those albums in Plex until a lyrics stream shows up. Existing lyrics files are left as they are.",
            yesText: "Write files",
            cancelText: "Cancel");
        if (confirmed != true)
            return;
        _job = await LyricsPage.StartApplyAsync(_job.Id) ?? _job;
        _tracks = _job.Tracks.ToList();
        _busy = _job.State == LyricsJobState.Running;
        StartPolling();
    }

    private async Task RefreshAlbum(string albumKey)
    {
        if (_job is null)
            return;
        _busy = true;
        _notice = null;
        try
        {
            _noticeError = false;
            _notice = await LyricsPage.RefreshAlbumAsync(_job.Id, albumKey);
        }
        catch (Exception exception) when (exception is PlexBridgeException or PlexRequestException)
        {
            _noticeError = true;
            _notice = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartPolling()
    {
        StopPolling();
        _poll = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = PollAsync(_poll.Token);
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    var latest = await LyricsPage.LatestAsync();
                    if (latest is null)
                        return;
                    _job = latest;
                    _tracks = latest.Tracks.ToList();
                    _busy = latest.State == LyricsJobState.Running;
                    if (_page > _pageCount)
                        _page = _pageCount;
                    if (latest.State != LyricsJobState.Running)
                        await LoadSync();
                    StateHasChanged();
                });
                if (_job?.State != LyricsJobState.Running)
                    break;
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void StopPolling()
    {
        _poll?.Cancel();
        _poll?.Dispose();
        _poll = null;
        _timer?.Dispose();
        _timer = null;
    }

    private async Task LoadSync()
    {
        try
        {
            _syncItems = (await LyricsPage.SyncItemsAsync()).ToList();
            ApplySync();
            EnsureSyncTimer();
        }
        catch (Exception)
        {
            // The list is optional. A failed read leaves the last list on screen.
        }
    }

    private void ApplySync()
    {
        var open = _syncItems.Where(item => item.ServerId == _serverId).ToList();
        foreach (var track in _tracks)
        {
            var match = open.FirstOrDefault(item => item.RatingKey == track.RatingKey);
            var written = track.ApplyResult?.StartsWith("Wrote ", StringComparison.Ordinal) == true
                || track.Status is LyricsSyncStatus.Waiting or LyricsSyncStatus.Missed or LyricsSyncStatus.Done;
            if (!written)
                continue;
            if (match is not null)
            {
                _seenSync.Add(track.RatingKey);
                track.Status = match.Status;
                if (match.Status == LyricsSyncStatus.Missed)
                    track.ApplyResult = "Not picked up by Plex yet.";
                continue;
            }

            if (_seenSync.Contains(track.RatingKey) && track.Status is LyricsSyncStatus.Waiting or LyricsSyncStatus.Missed)
            {
                track.Status = LyricsSyncStatus.Done;
                track.ApplyResult = "Plex shows a lyrics stream.";
                _seenSync.Remove(track.RatingKey);
            }
        }
    }

    private void EnsureSyncTimer()
    {
        if (_syncTimer is not null)
            return;
        if (_syncItems.All(item => item.Status != LyricsSyncStatus.Waiting))
            return;
        _syncPoll = new CancellationTokenSource();
        _syncTimer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        _ = PollSyncAsync(_syncPoll.Token);
    }

    private async Task PollSyncAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (await _syncTimer!.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    await LoadSync();
                    StateHasChanged();
                });
                if (_syncItems.All(item => item.Status != LyricsSyncStatus.Waiting))
                    break;
            }
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            if (!cancellationToken.IsCancellationRequested)
                StopSyncPolling();
        }
    }

    private void StopSyncPolling()
    {
        _syncPoll?.Cancel();
        _syncPoll?.Dispose();
        _syncPoll = null;
        _syncTimer?.Dispose();
        _syncTimer = null;
    }

    private async Task RefreshSync(LyricsSyncRow item)
    {
        _busy = true;
        _notice = null;
        try
        {
            _noticeError = false;
            _notice = await LyricsPage.RefreshSyncAsync(item.Id);
            await LoadSync();
        }
        catch (Exception exception) when (exception is PlexBridgeException or PlexRequestException)
        {
            _noticeError = true;
            _notice = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private Task RefreshSyncTrack(LyricsTrackRow track)
    {
        var item = _syncItems.FirstOrDefault(candidate => candidate.ServerId == _serverId && candidate.RatingKey == track.RatingKey);
        return item is null ? Task.CompletedTask : RefreshSync(item);
    }

    private string SyncTitle(LyricsSyncRow item)
    {
        var name = string.IsNullOrWhiteSpace(item.Artist) ? item.Title : item.Artist + " — " + item.Title;
        if (!string.IsNullOrWhiteSpace(item.Album))
            name += " — " + item.Album;
        if (_editors.Count > 1)
            name = "Server " + item.Slot + " · " + name;
        return name;
    }

    private IEnumerable<LyricsTrackRow> Filtered()
    {
        return _filter switch
        {
            "ready" => _tracks.Where(row => row.CanSelect),
            "have" => _tracks.Where(row => row.Status == LyricsStatus.AlreadyHas),
            "problem" => _tracks.Where(row => row.Status is LyricsStatus.NotReachable or LyricsStatus.NotWritable or LyricsStatus.NotFound or LyricsStatus.LookupFailed or LyricsStatus.Instrumental),
            _ => _tracks
        };
    }

    private IEnumerable<IGrouping<string, LyricsTrackRow>> PageGroups()
    {
        var groups = Filtered()
            .GroupBy(row => row.AlbumKey + "\n" + row.Artist + "\n" + row.Album)
            .ToList();
        var skip = (_page - 1) * 15;
        return groups.Skip(skip).Take(15);
    }

    private int _pageCount => Math.Max(1, (int)Math.Ceiling(Filtered().GroupBy(row => row.AlbumKey + "\n" + row.Artist + "\n" + row.Album).Count() / 15d));

    private void SetFilter(string filter)
    {
        _filter = filter;
        _page = 1;
    }

    private Variant FilterVariant(string filter)
        => _filter == filter ? Variant.Filled : Variant.Outlined;

    private int SelectedCount()
        => _tracks.Count(row => row.Selected && row.CanSelect);

    private string Summary()
    {
        int Count(string status) => _tracks.Count(row => row.Status == status);
        return Count(LyricsStatus.Synced) + " synced, "
            + Count(LyricsStatus.Plain) + " plain, "
            + Count(LyricsStatus.NotFound) + " not found, "
            + Count(LyricsStatus.AlreadyHas) + " already have lyrics, "
            + Count(LyricsStatus.NotReachable) + " path not reachable, "
            + Count(LyricsSyncStatus.Waiting) + " waiting for sync, "
            + Count(LyricsSyncStatus.Missed) + " not picked up";
    }

    private static string AlbumLabel(PlexCatalogItem album)
        => string.IsNullOrWhiteSpace(album.Artist) ? album.Title : album.Artist + " — " + album.Title;

    private static string? Blank(string value)
        => string.IsNullOrWhiteSpace(value) ? null : value;

    private static double Percent(int done, int total)
        => total <= 0 ? 0 : Math.Clamp(done * 100d / total, 0, 100);

    public void Dispose()
    {
        StopPolling();
        StopSyncPolling();
    }

    private sealed class LyricsServerEditor
    {
        public int ServerId { get; set; }
        public int Slot { get; set; }
        public string Name { get; set; } = "";
        public string BaseUrl { get; set; } = "";
        public bool HasToken { get; set; }
        public bool AutoCheck { get; set; }
        public int IntervalHours { get; set; } = 12;
        public DateTimeOffset? LastAutoCheckUtc { get; set; }
        public string SectionKey { get; set; } = "";
        public string SectionTitle { get; set; } = "";
        public string ContainerFolder { get; set; } = "/libraries";
        public bool UseManualMaps { get; set; }
        public int SyncIntervalMinutes { get; set; } = 2;
        public int SyncWindowMinutes { get; set; } = 30;
        public string? LibraryNote { get; set; }
        public List<PlexSectionInfo> Libraries { get; set; } = [];
        public List<LyricsMapInput> Maps { get; set; } = [];
        public List<LyricsLocationMatch> Matches { get; set; } = [];
    }
}
